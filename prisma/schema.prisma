generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TableType {
  SNOOKER
  POOL
}

enum ShopProductCategory {
  CUES
  TIPS
  CHALK
  GLOVES
  CASES
  ACCESSORIES
}

enum SessionSource {
  ONLINE
  WALKIN
  MAINTENANCE
}

enum SessionStatus {
  HELD
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  CASH
  UPI
  CARD
}

enum SessionGameFormat {
  SINGLES
  DOUBLES
  GROUP
  SOLO
}

enum PlayerDiscipline {
  SNOOKER
  POOL
  BOTH
}

enum PlayerSkillTier {
  NOVICE
  CLUB_REGULAR
  STATE_PRO
  PROFESSIONAL
}

model Table {
  id         String    @id @default(cuid())
  name       String    @unique
  type       TableType
  hourlyRate Int       @map("hourly_rate")
  isActive   Boolean   @default(true) @map("is_active")
  sessions   Session[]

  @@map("tables")
}

model Supervisor {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String    @map("password_hash")
  role         String    @default("supervisor")
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[] @relation("CreatedBy")

  @@map("supervisors")
}

model Tournament {
  id        String   @id @default(cuid())
  title     String
  date      DateTime @db.Date
  entryFee  Int      @map("entry_fee")
  prizePool Int      @map("prize_pool")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@map("tournaments")
}

model CafeteriaItem {
  id        String   @id @default(cuid())
  name      String   @unique
  note      String?
  price     Int
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, name])
  @@map("cafeteria_items")
}

model ShopProduct {
  id              String              @id @default(cuid())
  name            String
  description     String
  imagePath       String              @map("image_path")
  category        ShopProductCategory
  price           Int
  discountPercent Int                 @default(0) @map("discount_percent")
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([isActive, category, name])
  @@index([createdAt(sort: Desc)])
  @@map("shop_products")
}

model PlayerProfile {
  id                String              @id @default(cuid())
  fullName          String              @map("full_name")
  nickname          String?
  phone             String              @unique
  primaryDiscipline PlayerDiscipline    @default(BOTH) @map("primary_discipline")
  preferredFormat   SessionGameFormat?  @map("preferred_format")
  skillTier         PlayerSkillTier     @default(CLUB_REGULAR) @map("skill_tier")
  tabEnabled        Boolean             @default(true) @map("tab_enabled")
  creditLimit       Int                 @default(5000) @map("credit_limit")
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  dues              SessionDue[]
  payments          PlayerTabPayment[]
  duePayments       SessionDuePayment[]

  @@index([isActive, fullName])
  @@index([nickname])
  @@map("player_profiles")
}

model Session {
  id                                   String             @id @default(cuid())
  table                                Table              @relation(fields: [tableId], references: [id])
  tableId                              String             @map("table_id")
  source                               SessionSource
  status                               SessionStatus
  startTime                            DateTime           @map("start_time")
  plannedEnd                           DateTime           @map("planned_end")
  actualStart                          DateTime?          @map("actual_start")
  actualEnd                            DateTime?          @map("actual_end")
  holdExpiresAt                        DateTime?          @map("hold_expires_at")
  customerName                         String?            @map("customer_name")
  customerPhone                        String?            @map("customer_phone")
  refCode                              String?            @unique @map("ref_code")
  players                              Json?
  gameFormat                           SessionGameFormat? @map("game_format")
  gameLabel                            String?            @map("game_label")
  walkInOpenEnded                      Boolean            @default(false) @map("walk_in_open_ended")
  loserName                            String?            @map("loser_name")
  rateSnapshot                         Int?               @map("rate_snapshot")
  durationMinutes                      Int?               @map("duration_minutes")
  amount                               Int?
  grossAmount                          Int?               @map("gross_amount")
  discountPercentBasisPoints           Int                @default(0) @map("discount_percent_basis_points")
  discountAmount                       Int                @default(0) @map("discount_amount")
  settlementDiscountPercentBasisPoints Int                @default(0) @map("settlement_discount_percent_basis_points")
  settlementDiscountAmount             Int                @default(0) @map("settlement_discount_amount")
  payerShares                          Json?              @map("payer_shares")
  paymentStatus                        PaymentStatus      @default(UNPAID) @map("payment_status")
  paymentMethod                        PaymentMethod?     @map("payment_method")
  payerName                            String?            @map("payer_name")
  paidAt                               DateTime?          @map("paid_at")
  dues                                 SessionDue[]
  createdBy                            Supervisor?        @relation("CreatedBy", fields: [createdById], references: [id])
  createdById                          String?            @map("created_by_id")
  createdAt                            DateTime           @default(now()) @map("created_at")
  updatedAt                            DateTime           @updatedAt @map("updated_at")

  @@index([tableId, status])
  @@index([tableId, startTime, plannedEnd])
  @@index([status, holdExpiresAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([source, createdAt(sort: Desc), id(sort: Desc)])
  @@index([paymentStatus, status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("sessions")
}

model SessionDue {
  id              String              @id @default(cuid())
  sessionId       String              @map("session_id")
  session         Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerProfileId String?             @map("player_profile_id")
  playerProfile   PlayerProfile?      @relation(fields: [playerProfileId], references: [id], onDelete: Restrict)
  payerName       String              @map("payer_name")
  amount          Int
  createdAt       DateTime            @default(now()) @map("created_at")
  payments        SessionDuePayment[]

  @@unique([sessionId, payerName])
  @@index([playerProfileId, createdAt])
  @@index([sessionId])
  @@map("session_dues")
}

model PlayerTabPayment {
  id              String              @id @default(cuid())
  playerProfileId String?             @map("player_profile_id")
  playerProfile   PlayerProfile?      @relation(fields: [playerProfileId], references: [id], onDelete: Restrict)
  payerName       String              @map("payer_name")
  amount          Int
  paymentMethod   PaymentMethod       @map("payment_method")
  createdAt       DateTime            @default(now()) @map("created_at")
  allocations     SessionDuePayment[]

  @@index([playerProfileId, createdAt(sort: Desc)])
  @@map("player_tab_payments")
}

model SessionDuePayment {
  id              String           @id @default(cuid())
  dueId           String           @map("due_id")
  due             SessionDue       @relation(fields: [dueId], references: [id], onDelete: Cascade)
  paymentId       String           @map("payment_id")
  payment         PlayerTabPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  playerProfileId String?          @map("player_profile_id")
  playerProfile   PlayerProfile?   @relation(fields: [playerProfileId], references: [id], onDelete: Restrict)
  amount          Int
  createdAt       DateTime         @default(now()) @map("created_at")

  @@unique([dueId, paymentId])
  @@index([playerProfileId, createdAt])
  @@index([paymentId])
  @@map("session_due_payments")
}
